---
layout: base.njk
---
<div class="page-hero">
<p class="ph-ey">{{ eyebrow }}</p>
<h1>{{ heading }}</h1>
<p class="ph-lead">{{ lead | safe }}</p>
</div>
<section class="content"><div class="ci">
{% for s in services %}
{% if s.url %}
<a class="service-block service-door" href="{{ s.url }}">
<h2>{{ s.title | safe }}</h2>
<p>{{ s.body | safe }}</p>
<ul>{% for t in s.tags %}<li>{{ t | safe }}</li>{% endfor %}</ul>
<span class="btn-step svc-more"><span class="bs-disc"><svg class="bs-em" aria-hidden="true"><use href="#bp-emblem"/></svg></span>Step inside &rarr;</span>
</a>
{% else %}
<div class="service-block">
<h2>{{ s.title | safe }}</h2>
<p>{{ s.body | safe }}</p>
<ul>{% for t in s.tags %}<li>{{ t | safe }}</li>{% endfor %}</ul>
</div>
{% endif %}
{% endfor %}
{% if additional_services %}
<div class="addl-divider"><p class="ph-ey">{{ additional_heading }}</p><p class="addl-note">{{ additional_note }}</p></div>
{% for s in additional_services %}
{% if s.url %}
<a class="service-block service-door" href="{{ s.url }}">
<h2>{{ s.title | safe }}</h2>
<p>{{ s.body | safe }}</p>
<ul>{% for t in s.tags %}<li>{{ t | safe }}</li>{% endfor %}</ul>
<span class="btn-step svc-more"><span class="bs-disc"><svg class="bs-em" aria-hidden="true"><use href="#bp-emblem"/></svg></span>Step inside &rarr;</span>
</a>
{% else %}
<div class="service-block">
<h2>{{ s.title | safe }}</h2>
<p>{{ s.body | safe }}</p>
<ul>{% for t in s.tags %}<li>{{ t | safe }}</li>{% endfor %}</ul>
</div>
{% endif %}
{% endfor %}
{% endif %}
<div class="cta-box">
<h2>{{ cta_heading | safe }}</h2>
<p>{{ cta_body | safe }}</p>
<a href="contact.html" class="btn">{{ cta_button | safe }}</a>
</div>
</div></section>
