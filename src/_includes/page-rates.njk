---
layout: base.njk
---
<div class="page-hero">
<p class="ph-ey">{{ eyebrow }}</p>
<h1>{{ heading }}</h1>
<p class="ph-lead">{{ lead | safe }}</p>
</div>
<section class="content"><div class="ci">
{% for g in rate_groups %}
<div class="service-block">
<h2>{{ g.title | safe }}</h2>
{% if g.price %}<p class="rate-line">{{ g.price | safe }}</p>{% endif %}
<p>{{ g.body | safe }}</p>
{% if g.tags %}<ul>{% for t in g.tags %}<li>{{ t | safe }}</li>{% endfor %}</ul>{% endif %}
</div>
{% endfor %}
<div class="cta-box">
<h2>{{ cta_heading | safe }}</h2>
<p>{{ cta_body | safe }}</p>
<a href="book.html" class="btn">{{ cta_button | safe }}</a>
</div>
</div></section>
